# Base path the site is served from.
#   /          custom domain at its apex (byzoneconstruction.ca)
#   /BYzone/   GitHub Pages project URL (avergeichik.github.io/BYzone/)
VITE_BASE=/

# The business's Google place ID. Only builds the "see all reviews" link —
# the reviews themselves come from the Worker, which holds the API key.
VITE_GOOGLE_PLACE_ID=

# Absolute URL of the Cloudflare Worker, with no trailing slash. The quote
# form posts to /quote and the Reviews section reads /reviews. Required:
# without it the form refuses to submit and the Reviews section hides itself.
VITE_API_URL=
