# Base path the site is served from.
#   /          custom domain at its apex (byzoneconstruction.ca)
#   /BYzone/   GitHub Pages project URL (avergeichik.github.io/BYzone/)
VITE_BASE=/

# Google Places, used by the Reviews section to pull live Google reviews.
# These are client-side values and end up in the built bundle; restrict the key
# by HTTP referrer in the Google Cloud console. Leave empty to omit the section.
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=

# Absolute URL of the quote-form endpoint. Defaults to /api/send-quote.
VITE_QUOTE_API_URL=
